# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS (localhost dev servers are also allowed).
FRONTEND_URL=http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Neon, Supabase, Railway, or any PostgreSQL 14+ database.
# Neon example: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/toju

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── AI ────────────────────────────────────────────────────────────────────────
# Optional. Without a key, triage uses the deterministic server rule engine.
# Signal extraction from discharge notes requires a valid Gemini key.
GEMINI_API_KEY=

# ── Offline sync ──────────────────────────────────────────────────────────────
SYNC_PAGE_SIZE=300

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# The Vercel/serverless backend keeps the outbox endpoints as safe stubs and
# does not run a WhatsApp Web browser. Use a separate worker to enable it.
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_PATH=.wwebjs_auth
WHATSAPP_CHROME_PATH=
