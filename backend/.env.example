# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS (the Vite dev server is also allowed).
FRONTEND_URL=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Leave unset to use the automatic development MongoDB fallback (file-backed,
# data stored in backend/.mongo-data). Set a real URI for production or when
# you already run MongoDB locally.
# Local example: mongodb://127.0.0.1:27017/toju
# Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/toju
# MONGODB_URI=mongodb://127.0.0.1:27017/toju

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── Offline sync ──────────────────────────────────────────────────────────────
SYNC_PAGE_SIZE=300

# ── WhatsApp (whatsapp-web.js) ────────────────────────────────────────────────
# Set to true only on a machine/container with Chrome or Chromium available.
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_PATH=.wwebjs_auth
# Optional explicit browser path, for example /usr/bin/chromium in Docker.
WHATSAPP_CHROME_PATH=
